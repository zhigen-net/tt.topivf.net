# App
APP_ENV=development
APP_DOMAIN=localhost

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=socialhub
POSTGRES_USER=socialhub
POSTGRES_PASSWORD=changeme_postgres

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme_redis

# MinIO
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme_minio
MINIO_BUCKET=socialhub-media
# 单个素材上限（字节）
ASSET_MAX_SIZE=209715200
# 素材直链的公网前缀；Facebook 等平台是自己来拉文件的，必须外网可达
PUBLIC_API_URL=http://localhost/api

# Facebook / Instagram
# 用于把短期用户令牌换成长期令牌；不配的话只能用系统用户令牌绑定主页
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# JWT
JWT_SECRET=changeme_jwt_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# Backend
BACKEND_PORT=3000

# Frontend
VITE_API_URL=http://localhost/api
